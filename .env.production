# ===========================================
# Dynamic Platform - Production Environment
# With External IronPDF And Playwright Services
# ===========================================

# Database Configuration
POSTGRES_DB=dynamic_platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=Aa@sdkhueos97skspqkemhys!

# JWT Configuration
JWT_SECRET=Y4wKpN8V0f5C2Jq7a9ZQHc3M6bF2eR1X0T8S9mA7LkU=
JWT_EXPIRATION=86400000

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://api.profily.site,https://salahatwa.github.io/dynamic-platform

# File Upload Limits
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

# Storage Configuration
STORAGE_LOCATION=/app/storage

# Backend Port (only if exposing directly, otherwise use reverse proxy)
# Backend Port (only if exposing directly, otherwise use reverse proxy)
BACKEND_PORT=8080

# Gotenberg Configuration (Primary PDF Engine - FREE)
GOTENBERG_ENABLED=true
GOTENBERG_SERVICE_URL=http://gotenberg:3000
GOTENBERG_SERVICE_TIMEOUT=60000

# IronPDF Configuration (External Service - REQUIRES LICENSE)
# Note: Uncomment and configure if you have IronPDF license
IRONPDF_ENABLED=false
IRONPDF_USE_EXTERNAL_ENGINE=false
IRONPDF_ENGINE_URL=
IRONPDF_ENGINE_TIMEOUT=60000
IRONPDF_MAX_WORKERS=4
IRONPDF_LICENSE_KEY=

# Playwright Configuration (External Service - FREE)
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_USE_EXTERNAL_SERVICE=true
PLAYWRIGHT_SERVICE_URL=http://playwright:3000
PLAYWRIGHT_SERVICE_TIMEOUT=60000

# PDF Engine Selection (gotenberg, playwright, ironpdf, flyingsaucer, auto)
# Default: gotenberg (free, high quality)
PDF_ENGINE=gotenberg

# Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Cloudflare R2 Storage (Optional)
CLOUDFLARE_R2_ENABLED=false
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Google Drive Storage (Optional)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
